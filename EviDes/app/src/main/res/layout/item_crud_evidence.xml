<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="16dp"
    android:background="@color/evides_tile"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtNote_Item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/evides_on_surface"
        android:textSize="16sp"
        tools:text="Golpe en la puerta" />

    <TextView
        android:id="@+id/txtDetail_Item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/evides_on_surface_variant"
        android:textSize="13sp"
        tools:text="PHOTO · #1" />
</LinearLayout>